# Copy to .env and fill in. NEVER commit .env.
# Use a TESTNET-ONLY MetaMask account (Account details -> Show private key).
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY
ETHERSCAN_API_KEY=

# Deployment options
ROUND_NAME=HKU Campus Public Goods Round
ROUND_MINUTES=4320
MIN_CONTRIB_ETH=0.0005
ALLOWLIST=false
SEED_MATCHING_ETH=0.02

# v2: one recipient per demo project, in order (Campus Water, Lecture Notes, Stray Cat).
# Use accounts that are NOT the deployer, e.g. MetaMask Account 7/8/9 or teammates.
RECIPIENTS=0xRECIPIENT_1,0xRECIPIENT_2,0xRECIPIENT_3
